<Window x:Class="DiamondFAB.Quote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Height="700"
        Width="800"
        MinHeight="600"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">

    <!-- THEME + STYLES -->
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="BgBrush"               Color="#0F1115"/>
        <SolidColorBrush x:Key="CardBrush"             Color="#181B22"/>
        <SolidColorBrush x:Key="CardBorderBrush"       Color="#242937"/>
        <SolidColorBrush x:Key="AccentBrush"           Color="#4C8DF6"/>
        <SolidColorBrush x:Key="AccentBrushHover"      Color="#6EA2FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#E9EDF5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#AAB2C5"/>
        <SolidColorBrush x:Key="InputBgBrush"          Color="#111319"/>
        <SolidColorBrush x:Key="InputBorderBrush"      Color="#2A3040"/>
        <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#3B4358"/>
        <SolidColorBrush x:Key="DividerBrush"          Color="#232838"/>
        <SolidColorBrush x:Key="ErrorBrush"            Color="#E74C3C"/>

        <!-- Typography -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H1}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Card container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Rounded TextBox -->
        <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multiline TextBox variant -->
        <Style x:Key="ModernMultilineTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="120"/>
        </Style>

        <!-- Primary Button -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Tab Control Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="16,12" Margin="0,0,4,0" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource InputBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="20">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                <TextBlock Text="Configure company info, rates, charges, file locations, and preferences"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- TABBED CONTENT -->
        <TabControl Grid.Row="1" Margin="20,10,20,0">

            <!-- GENERAL TAB -->
            <TabItem Header="General" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>

                        <!-- Company Info -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock Text="Customer Information" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                    <Button Content="Select Customer…" Style="{StaticResource SecondaryButton}"
                                            Width="150" Height="32" DockPanel.Dock="Right"
                                            Click="SelectCustomerButton_Click"
                                            ToolTip="Load info from saved customer"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Company Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompanyNameBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Customer company name (appears in PDF Bill To section)"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Company Address" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompanyAddressBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Customer address (appears in PDF Bill To section)"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Contact Email" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <TextBox x:Name="ContactEmailBox" Style="{StaticResource ModernTextBox}"
                                             ToolTip="Customer email address"/>
                                    <TextBlock x:Name="EmailErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                               Text="Please enter a valid email address"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Company Phone" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CompanyPhoneBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Customer phone number"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- RATES TAB -->
            <TabItem Header="Rates &amp; Charges" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>

                        <!-- Rates -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="3" Text="Pricing Rates" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hourly Laser Rate" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox x:Name="LaserRateBox" Style="{StaticResource ModernTextBox}"
                                             ToolTip="Cost per hour of laser time ($/hr)"/>
                                    <TextBlock x:Name="LaserRateErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                               Text="Must be a positive number"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="$/hour" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,14,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tax Rate" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBox x:Name="TaxRateBox" Style="{StaticResource ModernTextBox}"
                                             ToolTip="Sales tax percentage"/>
                                    <TextBlock x:Name="TaxRateErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                               Text="Must be between 0 and 100"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="%" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,14,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Default Discount" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <TextBox x:Name="DiscountPercentBox" Style="{StaticResource ModernTextBox}"
                                             ToolTip="Default discount percentage"/>
                                    <TextBlock x:Name="DiscountErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                               Text="Must be between 0 and 100"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="%" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,14,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Extra Charges -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="Extra Charges" Style="{StaticResource SectionTitle}"/>

                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="SetupHandlingCheck" Content="Setup / Handling"
                                          Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8"
                                          ToolTip="Enable setup/handling charge on all quotes"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SetupHandlingAmountBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Flat amount ($)"/>

                                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="DeburrCheck" Content="Deburr"
                                          Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8"
                                          ToolTip="Enable deburring charge"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DeburrAmountBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Flat amount ($)"/>

                                <CheckBox Grid.Row="3" Grid.Column="0" x:Name="WeldingCheck" Content="Welding"
                                          Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8"
                                          ToolTip="Enable welding charge"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="WeldingAmountBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Flat amount ($)"/>

                                <CheckBox Grid.Row="4" Grid.Column="0" x:Name="PaintCheck" Content="Paint"
                                          Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8"
                                          ToolTip="Enable painting charge"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PaintAmountBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Flat amount ($)"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PREFERENCES TAB -->
            <TabItem Header="Preferences" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>

                        <!-- Your Company Information -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Your Company Information" Style="{StaticResource SectionTitle}"
                                           ToolTip="Your business information (used in PDF headers)"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Your Company Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="YourCompanyNameBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Your business name (appears in PDF header)"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Your Company Address" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="YourCompanyAddressBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Your business address (appears in PDF header)"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Your Contact Email" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="YourContactEmailBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Your business email address"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Your Company Phone" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="YourCompanyPhoneBox" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Your business phone number"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Your Company Logo" Style="{StaticResource FieldLabel}"/>
                                <DockPanel Grid.Row="5" Grid.Column="1" LastChildFill="True">
                                    <Button Content="Browse..." DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                            Width="100" Height="32" Margin="8,0,0,0" Click="BrowseYourLogoButton_Click"
                                            ToolTip="Select your logo image - it will be copied to app settings"/>
                                    <TextBox x:Name="YourLogoPathBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                             ToolTip="Logo stored in app data (appears in PDF header)"/>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- File Locations -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="File Locations" Style="{StaticResource SectionTitle}"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Import Folder" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True">
                                        <Button Content="Browse..." DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                                Width="100" Height="32" Margin="8,0,0,0" Click="BrowseImportFolderButton_Click"
                                                ToolTip="Select default folder for XML imports"/>
                                        <TextBox x:Name="DefaultImportFolderBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                                 ToolTip="Default folder when importing XML files"/>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Quote Behavior -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Quote Behavior" Style="{StaticResource SectionTitle}"/>

                                <CheckBox Grid.Row="1" x:Name="PreserveTaxRateCheck" Content="Preserve historical tax rates when loading saved quotes"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8" IsChecked="True"
                                          ToolTip="When enabled, loaded quotes keep their original tax rate"/>

                                <CheckBox Grid.Row="2" x:Name="PreserveDiscountCheck" Content="Preserve historical discounts when loading saved quotes"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8" IsChecked="True"
                                          ToolTip="When enabled, loaded quotes keep their original discount"/>

                                <!-- Divider -->
                                <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                                <CheckBox Grid.Row="4" x:Name="ShowPartBreakdownCheck" Content="Show part-level breakdown in PDF quotes"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8" IsChecked="True"
                                          ToolTip="When enabled, part details are shown below each material's line items in the PDF"/>
                            </Grid>
                        </Border>

                        <!-- Terms & Conditions -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Terms &amp; Conditions" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="TermsBox" Grid.Row="1" Style="{StaticResource ModernMultilineTextBox}"
                                         ToolTip="Default terms and conditions for all quotes"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="VersionTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Version: Loading..." />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Width="120" Margin="0,0,10,0" Click="CancelButton_Click"
                            ToolTip="Close without saving"/>
                    <Button Content="Save Settings" Style="{StaticResource PrimaryButton}"
                            Width="150" Click="SaveButton_Click"
                            ToolTip="Save all changes"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
